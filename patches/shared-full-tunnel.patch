+package io.openflux.desktop.model
+
+import kotlinx.serialization.Serializable
+
+/** Explicit client-side exceptions; empty settings preserve the normal fast TUN path. */
+@Serializable
+data class VpnBypassConfig(
+    val lan: Boolean = false,
+    val domains: List<String> = emptyList(),
+    val apps: List<String> = emptyList(),
+) {
+    val enabled: Boolean get() = lan || domains.isNotEmpty() || apps.isNotEmpty()
+}
+
+fun AppSettings.vpnBypassConfig() = VpnBypassConfig(
+    lan = bypassLAN,
+    domains = bypassDomains.lines().map { it.trim() }.filter { it.isNotEmpty() }.distinct(),
+    apps = bypassApps.map { it.trim() }.filter { it.isNotEmpty() }.distinct(),
+)
