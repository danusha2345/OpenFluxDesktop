diff --git a/src/jvmMain/kotlin/io/openflux/desktop/platform/LinuxElevation.kt b/src/jvmMain/kotlin/io/openflux/desktop/platform/LinuxElevation.kt
new file mode 100644
index 0000000..8ed59df
--- /dev/null
+++ b/src/jvmMain/kotlin/io/openflux/desktop/platform/LinuxElevation.kt
@@ -0,0 +1,23 @@
+package io.openflux.desktop.platform
+
+import java.io.File
+
+/** Elevate only the core. The GUI and private profiles remain user-owned. */
+object LinuxElevation {
+    val linux: Boolean = System.getProperty("os.name").lowercase().contains("linux")
+    val root: Boolean get() = MacElevation.root
+
+    fun command(core: List<String>, log: File, stop: File, appPid: Long): List<String> =
+        listOf("pkexec", "/bin/sh", "-c", MacElevation.watchScript(core, log, stop, appPid))
+
+    fun cancelled(line: String): Boolean = line.contains("Not authorized", ignoreCase = true) ||
+        line.contains("authentication", ignoreCase = true)
+
+    fun checkRequirements() {
+        for (tool in listOf("pkexec", "ip", "nft", "resolvectl")) {
+            val found = System.getenv("PATH").orEmpty().split(File.pathSeparator)
+                .plus(listOf("/usr/sbin", "/sbin")).any { File(it, tool).canExecute() }
+            check(found) { "Для полного туннеля Linux нужна программа $tool" }
+        }
+    }
+}
