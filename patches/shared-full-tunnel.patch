+++ b/src/jvmMain/kotlin/io/openflux/desktop/core/TunnelReadiness.kt
@@ -0,0 +1,6 @@
+package io.openflux.desktop.core
+
+/** TUN is ready only after routes, DNS and leak protection succeeded. */
+internal fun readyBanner(line: String, fullTunnel: Boolean): Boolean =
+    if (fullTunnel) line.contains("Tunnel active")
+    else line.contains("Running as CLIENT") || line.contains("Running as EXIT NODE")
