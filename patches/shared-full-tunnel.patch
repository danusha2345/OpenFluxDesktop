+package io.openflux.desktop.core
+
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class TunnelReadinessTest {
+    @Test fun tunnelWaitsForProtection() {
+        assertFalse(readyBanner("Running as CLIENT", true))
+        assertFalse(readyBanner("FATAL: configure default", true))
+        assertTrue(readyBanner("Tunnel active", true))
+        assertTrue(readyBanner("Running as CLIENT", false))
+    }
+}
