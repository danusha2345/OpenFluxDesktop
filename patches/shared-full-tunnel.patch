@@ -0,0 +1,27 @@
+package io.openflux.desktop
+import io.openflux.desktop.model.*
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import kotlin.test.*
+class VpnBypassTest {
+ private val profile = Profile(id="p",name="Node",transport=TransportType.DIRECT,value="203.0.113.1:8445",secret="f".repeat(64),session=true)
+ private val paths = CorePaths("key","profile.conf","cookies.json","ipc.sock","C:/Run/bypass.json")
+ @Test fun oldSettingsStayDisabledAndNewRulesRoundTrip() {
+  assertFalse(Json.decodeFromString<AppSettings>("{}").vpnBypassConfig().enabled)
+  val settings=AppSettings(fullTunnel=true,bypassLAN=true,bypassDomains="bank.test\n  example.test \n\n",bypassApps=listOf("C:\\Any Torrent\\client.exe"))
+  val round=Json.decodeFromString<AppSettings>(Json.encodeToString(settings))
+  assertEquals(settings,round)
+  val config=round.vpnBypassConfig();assertEquals(listOf("bank.test","example.test"),config.domains)
+  assertTrue(config.lan);assertEquals(settings.bypassApps,config.apps)
+  val raw=Json.encodeToString(config);assertFalse("enabled" in raw)
+  assertEquals(config,Json.decodeFromString<VpnBypassConfig>(raw))
+ }
+ @Test fun exceptionsRequireFullTunnelAndAreNeverSentToTheExit() {
+  val settings=AppSettings(fullTunnel=true,bypassLAN=true)
+  val launch=CoreConfig.build(profile,settings,paths)
+  assertTrue("--bypass-config=C:/Run/bypass.json" in launch.arguments)
+  assertFalse("bypass" in launch.conf!!.lowercase())
+  assertFalse(CoreConfig.build(profile,settings.copy(fullTunnel=false),paths).arguments.any{it.startsWith("--bypass-config")})
+  assertFailsWith<IllegalArgumentException>{CoreConfig.build(profile,settings,paths.copy(bypassConfig=null))}
+ }
+}
